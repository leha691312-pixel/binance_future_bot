# Copy to .env and fill real keys
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Discord control (optional)
# 1. Tạo bot tại https://discord.com/developers/applications
# 2. Bật MESSAGE CONTENT INTENT
# 3. Invite bot vào server với quyền Send Messages + Read Message History
DISCORD_BOT_TOKEN=
# User ID được phép điều khiển (cách nhau bằng dấu phẩy). Bật Developer Mode trong Discord → Right click user → Copy ID
DISCORD_ALLOWED_IDS=
# Prefix lệnh (mặc định !)
DISCORD_PREFIX=!
